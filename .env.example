# Copy this file to .env for local development. Never commit actual credentials.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql+psycopg://ip_landmarks:change-me@localhost:5432/ip_landmarks
# 地图瓦片地址（默认 OpenStreetMap，可换成高德等合规瓦片服务；生产前请评估许可与流量）
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# 高德 Web 服务 Key：地理编码、酒店坐标与动线优化。申请：https://console.amap.com/dev/key/app
AMAP_WEB_SERVICE_API_KEY=
# 美团酒旅官方 Skill Token：行程草案与价格参考。申请：https://developer.meituan.com/zh/v2/dev/token
# MEITUAN_TRAVEL_TOKEN 为本地兼容别名，优先读取 MEITUAN_HT_TOKEN。
MEITUAN_HT_TOKEN=
MEITUAN_TRAVEL_TOKEN=
SEARCH_PROVIDER=bocha_web_search
# 博查 AI 搜索 Key：候选发现与行程资料检索。申请：https://open.bochaai.com/api-keys
BOCHA_API_KEY=
SEARCH_DAILY_QUOTA=50
# 管理员接口令牌（内部管理端使用，请勿公开）
ADMIN_API_TOKEN=
# LLM API Key（OpenAI 兼容接口，不限于 DeepSeek）：AI 行程生成。
# 默认使用 DeepSeek；其他服务商把 Key 填到这里，并在 DEEPSEEK_BASE_URL / DEEPSEEK_MODEL 填其接口地址与模型名。
# 申请（示例）：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
ROUTE_OPTIMIZER_PROVIDER=haversine
